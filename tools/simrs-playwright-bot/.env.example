# === Jalankan bot dari PC di jaringan RS (bukan dari Vercel cloud) ===
# Dipakai Node (tsx) DAN Python (python -m python.cli) di folder ini.

# getPasien API (LAN / WiFi RS)
SIMRS_GET_PASIEN_URL=http://10.250.10.107/apibdrs/apibdrs/getPasien

# SIMRS web UI (LAN)
SIMRS_WEB_URL=http://10.255.200.252/SIMRS/
SIMRS_WEB_USER=
SIMRS_WEB_PASS=

# idik-app (localhost atau Vercel — auth cookie)
# Wajib untuk Python: add --write (Playwright isi form)
# Untuk agen poll dari tombol UI: pakai URL Vercel produksi
IDIK_BASE_URL=https://idik-lemon.vercel.app
IDIK_USER=
IDIK_PASS=

# Token agen (HARUS sama dengan env Vercel SIMRS_BOT_AGENT_TOKEN)
SIMRS_BOT_AGENT_TOKEN=
# SIMRS_BOT_AGENT_POLL_MS=5000

# Browser (Node Playwright + Python Playwright)
HEADLESS=true

# Defaults form idik (TIDAK dari getPasien — jangan ditebak dari SIMRS)
IDIK_DEFAULT_JENIS_PEMBIAYAAN=Umum
IDIK_DEFAULT_KELAS_PERAWATAN=Kelas 3

# Skip existing No. RM on write (skip | update)
IDIK_ON_EXISTING=update

# Mock getPasien saat di luar LAN (path relatif ke folder bot)
# SIMRS_GET_PASIEN_MOCK=fixtures/getPasien-929331.json

# Status badge sync (POST ke idik)
IDIK_BOT_STATUS=1

# Explore
EXPLORE_CLICK_DELAY_MS=500
EXPLORE_MAX_DEPTH=12
# EXPLORE_DANGEROUS_EXTRA=hapus,delete,reset
