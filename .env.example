# Salin ke .env.local: cp .env.example .env.local  |  Windows: copy .env.example .env.local
# Isi nilai di bawah. Jangan commit .env.local.
# Auth & env: docs/AUTH-DB.md  |  Cek: npm run check:auth-env

# Wajib untuk production (next start / deploy). Disarankan sama di .env.local agar cookie JWT konsisten dengan middleware.
JWT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: URL publik (bukan untuk LoginModal — login memakai same-origin /api/auth).
# Hanya jika fitur lain butuh origin eksplisit.
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# URL API getPasien (HTTPS lewat Cloudflare Tunnel — dipakai proxy Vercel).
# Jangan isi IP 10.x di Vercel; lihat docs/simrs-tunnel.md (error 530 = tunnel/origin putus).
SIMRS_API_URL=https://simrs.inkai-jatim.org/apibdrs/apibdrs/getPasien
NEXT_PUBLIC_SIMRS_API_URL=https://simrs.inkai-jatim.org/apibdrs/apibdrs/getPasien
# Fallback browser di PC LAN RS (HTTP). Dari halaman HTTPS Vercel butuh "Allow insecure content".
NEXT_PUBLIC_SIMRS_API_URL_LAN=http://10.250.10.107/apibdrs/apibdrs/getPasien
# Badge status bot SIMRS di toolbar tindakan (0 = mati)
# NEXT_PUBLIC_SIMRS_BOT_STATUS=0
